{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "API disponivel",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "up{job=\"commercecore-api\"}", "refId": "A" }],
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Requisicoes HTTP por segundo",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{aplicacao=\"commercecore\"}[5m])) by (uri, method)",
        "legendFormat": "{{method}} {{uri}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Latencia p95",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{aplicacao=\"commercecore\"}[5m])) by (le, uri))",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
        "legendFormat": "Heap utilizado",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "schemaVersion": 41,
  "tags": ["commercecore", "spring-boot"],
  "templating": {
    "list": [{
      "name": "DS_PROMETHEUS",
      "type": "datasource",
      "query": "prometheus",
      "current": { "text": "Prometheus", "value": "Prometheus" }
    }]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "CommerceCore - Visao operacional",
  "uid": "commercecore-operacional",
  "version": 1
}
