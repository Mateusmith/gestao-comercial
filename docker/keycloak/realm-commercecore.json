{
  "realm": "commercecore",
  "displayName": "Gestão Comercial",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "ADMINISTRADOR" },
      { "name": "GERENTE_COMERCIAL" },
      { "name": "VENDEDOR" },
      { "name": "FATURISTA" },
      { "name": "GERENTE_ESTOQUE" },
      { "name": "ESTOQUISTA" },
      { "name": "GERENTE_COMPRAS" },
      { "name": "COMPRADOR" },
      { "name": "GERENTE_FINANCEIRO" },
      { "name": "FINANCEIRO" },
      { "name": "AUDITOR" }
    ]
  },
  "clients": [
    {
      "clientId": "commercecore-api",
      "name": "Gestão Comercial API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "commercecore-postman",
      "name": "Gestão Comercial Postman",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback",
        "http://localhost:*"
      ],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audiencia-commercecore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "commercecore-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "filiais-permitidas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "filiais",
            "claim.name": "filiais",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@commercecore.local",
      "email": "admin@commercecore.local",
      "firstName": "Administrador",
      "lastName": "Gestão Comercial",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "CommerceCore@123", "temporary": false }
      ],
      "realmRoles": ["ADMINISTRADOR"],
      "attributes": { "filiais": ["22222222-2222-2222-2222-222222222222"] }
    },
    {
      "username": "vendedor@commercecore.local",
      "email": "vendedor@commercecore.local",
