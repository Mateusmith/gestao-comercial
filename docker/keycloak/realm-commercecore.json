      "credentials": [
        { "type": "password", "value": "CommerceCore@123", "temporary": false }
      ],
      "realmRoles": ["VENDEDOR", "GERENTE_COMERCIAL", "FATURISTA"],
      "attributes": { "filiais": ["22222222-2222-2222-2222-222222222222"] }
    },
    {
      "username": "comprador@commercecore.local",
